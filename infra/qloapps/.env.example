# Copiez ce fichier en .env et gardez les valeurs hors de Git.
QLOAPPS_HTTP_PORT=8088
QLOAPPS_DB_NAME=agentpms_qloapps
QLOAPPS_DB_ROOT_PASSWORD=replace-with-a-local-password
QLOAPPS_SSH_PASSWORD=replace-with-a-local-password
QLOAPPS_ADMIN_EMAIL=admin@agentpms.local
QLOAPPS_ADMIN_PASSWORD=replace-with-a-local-admin-password
QLOAPPS_ADMIN_PATH=admin-agentpms
QLOAPPS_API_KEY=replace-with-an-exactly-32-character-key
QLOAPPS_SEED_API_KEY=replace-with-a-different-32-character-key
QLOAPPS_WRITE_API_KEY=replace-with-a-third-32-character-key
