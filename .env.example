# Aucun secret ne doit etre committe. Ces valeurs sont des exemples.
AGENTPMS_RAG_PROJECT=../reception-assistant-rag
AGENTPMS_KNOWLEDGE_URL=http://127.0.0.1:8765/knowledge/query
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
AGENTPMS_LLM_BASE_URL=https://api.deepseek.com/beta
AGENTPMS_LLM_MODEL=deepseek-v4-flash
AGENTPMS_LLM_REASONING_EFFORT=low
AGENTPMS_DECISION_PROVIDER=deepseek
# Pour un autre endpoint compatible OpenAI, utiliser son URL, son modele,
# AGENTPMS_LLM_API_KEY et AGENTPMS_DECISION_PROVIDER=openai_compatible.
AGENTPMS_KNOWLEDGE_ENABLED=false
AGENTPMS_MAX_STEPS=6
AGENTPMS_CONFIRMATION_TTL_SECONDS=300
# Demander une categorie lorsque la creation n'en precise aucune.
AGENTPMS_DEFAULT_ROOM_SELECTION=ask
AGENTPMS_PMS_PROVIDER=qloapps
AGENTPMS_QLOAPPS_BASE_URL=http://127.0.0.1:8088/api
AGENTPMS_QLOAPPS_API_KEY=replace-with-the-local-qloapps-api-key
AGENTPMS_QLOAPPS_WRITE_API_KEY=replace-with-the-local-qloapps-write-api-key
AGENTPMS_QLOAPPS_HOTEL_ID=1
AGENTPMS_QLOAPPS_TIMEOUT_SECONDS=15
AGENTPMS_QLOAPPS_BOOKING_SCAN_LIMIT=200
AGENTPMS_QLOAPPS_EMPLOYEE_ID=1
